# Copia este archivo como .env.production y pon tus valores. .env.production no se sube a git.

# Dentro del contenedor "localhost" es el propio contenedor: tu máquina es host.docker.internal.
ConnectionStrings__DefaultConnection=Host=host.docker.internal;Port=5432;Database=caudal_db;Username=postgres;Password=CAMBIAR

# Debe coincidir con la URL pública: es la que llevan los enlaces de los correos.
App__BaseUrl=https://localhost:7443

Email__Host=smtp.gmail.com
Email__Port=587
Email__Security=StartTls
Email__UserName=tu-cuenta@gmail.com
Email__Password=CAMBIAR
Email__FromAddress=tu-cuenta@gmail.com
Email__FromName=Caudal

# Certificado de .certs/caudal.pfx. Para probar en local:
#   mkdir -p .certs && dotnet dev-certs https -ep .certs/caudal.pfx -p CAMBIAR && chmod 644 .certs/caudal.pfx
ASPNETCORE_Kestrel__Certificates__Default__Password=CAMBIAR
