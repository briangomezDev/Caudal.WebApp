@{
    Layout = "_RestorePasswordLayout";
    ViewData["Title"] = "Contraseña actualizada";
}
<div class="steps-mini" role="img" aria-label="Proceso completado"><span class="on"></span><span class="on"></span><span class="on"></span></div>
<div class="has-text-centered">
    <div class="icon-circle is-centered"><svg class="ic"><use href="#i-check" /></svg></div>
    <h2 class="title is-4 mb-1">Contraseña actualizada</h2>
    <p class="subtitle is-6 mb-5">Ya puedes entrar con tu nueva contraseña.</p>
    <a class="button is-primary is-medium is-fullwidth" asp-controller="Account" asp-action="Login">Ir a iniciar sesión</a>
</div>
