@{
    Layout = "_AuthLayout";
    ViewData["BrandVariant"] = "restore";
    ViewData["BrandTitle"] = "Recupera el acceso en tres pasos.";
    ViewData["BrandLead"] = "Te enviamos un código de 6 dígitos que vence en 10 minutos. Por seguridad, cerramos tus otras sesiones al cambiar la contraseña.";
}
<a asp-controller="Account" asp-action="Login" class="is-size-7 has-text-weight-semibold is-inline-flex is-align-items-center mb-5"><svg class="ic mr-1"><use href="#i-left" /></svg>Volver a iniciar sesión</a>
@RenderBody()
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
