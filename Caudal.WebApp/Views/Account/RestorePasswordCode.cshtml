@{
    Layout = "_RestorePasswordLayout";
    ViewData["Title"] = "Revisa tu correo";
}
<div class="steps-mini" role="img" aria-label="Paso 2 de 3"><span class="on"></span><span class="on"></span><span></span></div>
<div class="icon-circle"><svg class="ic"><use href="#i-lock" /></svg></div>
<h2 class="title is-4 mb-1">Revisa tu correo</h2>
<p class="subtitle is-6 mb-5">Enviamos un código a tu correo electrónico.</p>
<form asp-controller="Account" asp-action="RestorePasswordCode" method="post">
    <label class="label" for="code-0">Código de verificación</label>
    <input type="hidden" name="Code" data-code-value />
    <div class="code-inputs" data-code-inputs>
        <input class="input" id="code-0" inputmode="numeric" autocomplete="one-time-code" maxlength="1" pattern="[0-9]" aria-label="Dígito 1" required />
        <input class="input" id="code-1" inputmode="numeric" autocomplete="off" maxlength="1" pattern="[0-9]" aria-label="Dígito 2" required />
        <input class="input" id="code-2" inputmode="numeric" autocomplete="off" maxlength="1" pattern="[0-9]" aria-label="Dígito 3" required />
        <input class="input" id="code-3" inputmode="numeric" autocomplete="off" maxlength="1" pattern="[0-9]" aria-label="Dígito 4" required />
        <input class="input" id="code-4" inputmode="numeric" autocomplete="off" maxlength="1" pattern="[0-9]" aria-label="Dígito 5" required />
        <input class="input" id="code-5" inputmode="numeric" autocomplete="off" maxlength="1" pattern="[0-9]" aria-label="Dígito 6" required />
    </div>
    <p class="help mt-2">¿No llegó? Revisa spam o <a asp-controller="Account" asp-action="RestorePassword">reenvía el código</a></p>
    <button class="button is-primary is-medium is-fullwidth mt-4" type="submit">Verificar código</button>
</form>
