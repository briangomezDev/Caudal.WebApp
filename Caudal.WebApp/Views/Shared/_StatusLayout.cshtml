<!DOCTYPE html>
<html lang="es">
<head>
    <partial name="_Head" />
</head>
<body>
    <partial name="_Icons" />
    <main class="view status-page">
        <div class="status-inner">
            <a class="logo" asp-controller="Platform" asp-action="Index"><partial name="_Logo" /></a>
            @RenderBody()
        </div>
    </main>
    <script src="~/js/caudal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
