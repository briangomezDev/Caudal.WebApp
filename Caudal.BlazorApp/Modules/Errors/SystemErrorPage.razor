@page "/Error/{StatusCode:int}"
@layout StatusLayout
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>Error del sistema · Caudal</PageTitle>

<svg class="status-art is-error" viewBox="0 0 320 120" aria-hidden="true">
    <path class="flow" d="M8 40 C 40 24, 72 56, 112 40" /><path class="flow" d="M196 40 C 236 24, 272 56, 312 40" />
    <path class="flow" d="M8 64 C 40 48, 72 80, 112 64" /><path class="flow" d="M196 64 C 236 48, 272 80, 312 64" />
    <path class="flow" d="M8 88 C 40 72, 72 104, 112 88" /><path class="flow" d="M196 88 C 236 72, 272 104, 312 88" />
    <path class="crack" d="M134 22 L 150 52 L 140 62 L 164 98" />
    <path class="crack" d="M170 24 L 178 46" />
</svg>
<p class="eyebrow">Error 500</p>
<h1 class="title is-3 mt-2 mb-3">Algo falló de nuestro lado</h1>
<p class="status-lead">No es tu culpa. Tus datos están a salvo y no se guardó ningún cambio a medias. Ya registramos el problema.</p>
<div class="ref-box">
    <div>
        <span class="eyebrow">Código de referencia</span>
        <code id="err-ref">@requestId</code>
    </div>
    <button class="button is-small" type="button" data-copy="err-ref" aria-live="polite"><svg class="ic mr-1"><use href="#i-check" /></svg><span data-copy-label>Copiar</span></button>
</div>
<p class="help mt-2">Si el problema continúa, comparte este código con soporte para encontrarlo rápido.</p>
<div class="buttons is-centered mt-5">
    <a class="button is-primary is-medium" href="@retryUrl" data-enhance-nav="false"><svg class="ic mr-2"><use href="#i-repeat" /></svg>Reintentar</a>
    <a class="button is-medium" href="/">Ir al resumen</a>
</div>

@code {
    private string? requestId;
    private string retryUrl = "/";

    [Parameter] public int StatusCode { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        if (HttpContext is null) return;

        HttpContext.Response.Headers.CacheControl = "no-store";
        retryUrl = HttpContext.Features.Get<IExceptionHandlerPathFeature>()?.Path
            ?? HttpContext.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalPath
            ?? "/";
    }
}
