@page "/account/restore-password-new"
@layout RestorePasswordLayout

<PageTitle>Nueva contraseña · Caudal</PageTitle>

<div class="steps-mini" role="img" aria-label="Paso 3 de 3"><span class="on"></span><span class="on"></span><span class="on"></span></div>
<div class="icon-circle"><svg class="ic"><use href="#i-shield" /></svg></div>
<h2 class="title is-4 mb-1">Crea una nueva contraseña</h2>
<p class="subtitle is-6 mb-5">Que sea distinta de las que usaste antes.</p>
<PendingForm Name="restore-password-new">
    <div class="field">
        <label class="label" for="rec-pass">Nueva contraseña</label>
        <div class="field has-addons mb-0">
            <div class="control is-expanded"><input class="input" id="rec-pass" name="Password" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" minlength="8" maxlength="128" required data-strength="rec-strength" /></div>
            <div class="control"><button type="button" class="button" data-toggle-pass="rec-pass" aria-label="Mostrar contraseña"><svg class="ic"><use href="#i-eye" /></svg></button></div>
        </div>
        <div class="strength" id="rec-strength" data-lvl="0"><i></i><i></i><i></i><i></i></div>
    </div>
    <div class="field">
        <label class="label" for="rec-pass2">Confirma la contraseña</label>
        <div class="control"><input class="input" id="rec-pass2" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></div>
    </div>
    <label class="checkbox is-size-7"><input type="checkbox" id="rec-close" name="CloseOtherSessions" value="true" checked /> Cerrar sesión en los demás dispositivos</label>
    <button class="button is-primary is-medium is-fullwidth mt-4" type="submit">Guardar contraseña</button>
</PendingForm>
