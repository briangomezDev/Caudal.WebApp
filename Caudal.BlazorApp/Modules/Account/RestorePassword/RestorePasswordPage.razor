@page "/account/restore-password"
@layout RestorePasswordLayout

<PageTitle>Recuperar contraseña · Caudal</PageTitle>

<div class="steps-mini" role="img" aria-label="Paso 1 de 3"><span class="on"></span><span></span><span></span></div>
<div class="icon-circle"><svg class="ic"><use href="#i-mail" /></svg></div>
<h2 class="title is-4 mb-1">¿Olvidaste tu contraseña?</h2>
<p class="subtitle is-6 mb-5">Escribe el correo de tu cuenta y te enviaremos un código.</p>
<PendingForm Name="restore-password">
    <div class="field">
        <label class="label" for="rec-email">Correo electrónico</label>
        <div class="control has-icons-left">
            <input class="input is-medium" id="rec-email" name="Email" type="email" autocomplete="email" placeholder="tu@correo.com" required />
            <span class="icon is-left"><svg class="ic"><use href="#i-mail" /></svg></span>
        </div>
    </div>
    <button class="button is-primary is-medium is-fullwidth mt-3" type="submit">Enviar código</button>
</PendingForm>
