@implements IDisposable
@inject RegisterFacade Facade
@inject NavigationManager Navigation
@inject IJSRuntime JS

<form novalidate @onsubmit="SubmitAsync">
    <div class="field">
        <label class="label" for="reg-name">Nombre</label>
        <div class="control has-icons-left">
            <input class="input @DangerClass(RegisterField.FullName)" id="reg-name" type="text" autocomplete="name" placeholder="¿Cómo te llamamos?" maxlength="150" required aria-describedby="reg-name-error" aria-invalid="@Invalid(RegisterField.FullName)"
                   @ref="nameInput" @bind="form.FullName" @bind:event="oninput" @bind:after="() => OnEdited(RegisterField.FullName)" @onblur="() => OnBlurAsync(RegisterField.FullName)" />
            <span class="icon is-left"><svg class="ic"><use href="#i-user" /></svg></span>
        </div>
        <FieldError Id="reg-name-error" Message="@ErrorOf(RegisterField.FullName)" />
    </div>
    <div class="field">
        <label class="label" for="reg-email">Correo electrónico</label>
        <div class="control has-icons-left">
            <input class="input @DangerClass(RegisterField.Email)" id="reg-email" type="email" autocomplete="email" placeholder="tu@correo.com" maxlength="100" required aria-describedby="reg-email-error" aria-invalid="@Invalid(RegisterField.Email)"
                   @ref="emailInput" @bind="form.Email" @bind:event="oninput" @bind:after="() => OnEdited(RegisterField.Email)" @onblur="() => OnBlurAsync(RegisterField.Email)" />
            <span class="icon is-left"><svg class="ic"><use href="#i-mail" /></svg></span>
        </div>
        <FieldError Id="reg-email-error" Message="@ErrorOf(RegisterField.Email)" />
    </div>
    <div class="field">
        <label class="label" for="reg-pass">Contraseña</label>
        <div class="field has-addons mb-0">
            <div class="control has-icons-left is-expanded">
                <input class="input @DangerClass(RegisterField.Password)" id="reg-pass" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" minlength="8" maxlength="128" required aria-describedby="reg-strength-txt reg-pass-error" aria-invalid="@Invalid(RegisterField.Password)" data-strength="reg-strength" data-strength-text="reg-strength-txt"
                       @ref="passwordInput" @bind="form.Password" @bind:event="oninput" @bind:after="() => OnEdited(RegisterField.Password)" @onblur="() => OnBlurAsync(RegisterField.Password)" />
                <span class="icon is-left"><svg class="ic"><use href="#i-lock" /></svg></span>
            </div>
            <div class="control"><button type="button" class="button" data-toggle-pass="reg-pass" aria-label="Mostrar contraseña"><svg class="ic"><use href="#i-eye" /></svg></button></div>
        </div>
        <div class="strength" id="reg-strength" data-lvl="0"><i></i><i></i><i></i><i></i></div>
        <p class="help" id="reg-strength-txt" aria-live="polite">Usa 8 o más caracteres, con un número y una mayúscula.</p>
        <FieldError Id="reg-pass-error" Message="@ErrorOf(RegisterField.Password)" />
    </div>
    <div class="field">
        <label class="checkbox is-size-7">
            <input type="checkbox" id="reg-terms" required aria-describedby="reg-terms-error" aria-invalid="@Invalid(RegisterField.Terms)"
                   @ref="termsInput" @bind="form.Terms" @bind:after="() => OnEdited(RegisterField.Terms)" @onblur="() => OnBlurAsync(RegisterField.Terms)" />
            Acepto los <a href="/terms">términos</a> y la <a href="/privacy">política de privacidad</a>
        </label>
        <FieldError Id="reg-terms-error" Message="@ErrorOf(RegisterField.Terms)" />
    </div>
    <div class="notification is-danger is-light @(generalError is null ? "is-hidden" : "")" role="alert">@generalError</div>
    @* Antes de conectar el circuito el formulario no tiene quién lo procese. *@
    <button class="button is-tertiary is-fullwidth is-medium mt-4 @(loading ? "is-loading" : "")" type="submit" disabled="@(loading || !RendererInfo.IsInteractive)">Crear cuenta</button>
</form>

@code {
    private readonly RegisterForm form = new();
    private readonly CancellationTokenSource lifetime = new();
    private readonly HashSet<RegisterField> touched = [];
    private IReadOnlyDictionary<RegisterField, string> errors = new Dictionary<RegisterField, string>();
    private string? generalError;
    private bool loading;
    private bool focusFirstError;

    private ElementReference nameInput;
    private ElementReference emailInput;
    private ElementReference passwordInput;
    private ElementReference termsInput;

    private string? ErrorOf(RegisterField field) => errors.GetValueOrDefault(field);
    private string DangerClass(RegisterField field) => errors.ContainsKey(field) ? "is-danger" : "";
    private string Invalid(RegisterField field) => errors.ContainsKey(field) ? "true" : "false";

    // Editar también reemplaza el error que haya devuelto el servidor para ese campo.
    private void OnEdited(RegisterField field)
    {
        generalError = null;
        Refresh(field);
    }

    private async Task OnBlurAsync(RegisterField field)
    {
        if (!touched.Add(field)) return;

        // Mostrar el error mueve el formulario: si se hace durante un clic, el clic puede fallar.
        await JS.InvokeVoidAsync("caudal.afterClick");
        Refresh(field);
    }

    // Solo los campos que el usuario ya abandonó o intentó enviar muestran su error.
    private void Refresh(RegisterField field)
    {
        var current = errors.ToDictionary();
        current.Remove(field);

        if (touched.Contains(field) && Facade.Validate(form).TryGetValue(field, out var message))
            current[field] = message;

        errors = current;
    }

    private async Task SubmitAsync()
    {
        if (loading) return;

        touched.UnionWith(Enum.GetValues<RegisterField>());
        errors = new Dictionary<RegisterField, string>();
        generalError = null;
        loading = true;

        var result = await Facade.RegisterAsync(form, lifetime.Token);

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/account/check-email");
            return; // la página se va; dejamos el botón bloqueado
        }

        errors = result.FieldErrors;
        generalError = result.Message;
        focusFirstError = true;
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusFirstError) return;
        focusFirstError = false;

        if (errors.ContainsKey(RegisterField.FullName)) await nameInput.FocusAsync();
        else if (errors.ContainsKey(RegisterField.Email)) await emailInput.FocusAsync();
        else if (errors.ContainsKey(RegisterField.Password)) await passwordInput.FocusAsync();
        else if (errors.ContainsKey(RegisterField.Terms)) await termsInput.FocusAsync();
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
